datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String    @id @default(uuid())
  name           String    @unique
  pin            String    // hashed PIN
  role           String    // "ADMIN" or "CASHIER"
  needsPinReset  Boolean   @default(true)
  invoices       Invoice[] @relation("CreatedInvoices")
  cancelledInvs  Invoice[] @relation("CancelledInvoices")
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  color String @default("bg-blue-500")
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique
  totalAmount        Float
  paymentMethod      String        // "CASH" or "ONLINE"
  status             String        @default("VALIDATED") // "VALIDATED", "CANCELLED"
  cancellationReason String?
  createdAt          DateTime      @default(now())
  createdById        String
  createdBy          User          @relation("CreatedInvoices", fields: [createdById], references: [id])
  cancelledById      String?
  cancelledBy        User?         @relation("CancelledInvoices", fields: [cancelledById], references: [id])
  items              InvoiceItem[]
}

model InvoiceItem {
  id           String  @id @default(uuid())
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  categoryName String
  price        Float
}
