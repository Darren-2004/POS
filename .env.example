# ─────────────────────────────────────────────
#  CONFIGURATION SERVEUR POS
# ─────────────────────────────────────────────

# Base de données SQLite (ne pas modifier)
DATABASE_URL="file:./dev.db"

# Port du serveur Express (défaut: 5000)
PORT=5000

# ─────────────────────────────────────────────
#  CONFIGURATION IMPRIMANTE THERMIQUE 80mm
# ─────────────────────────────────────────────

# ▶ Cas 1 — Imprimante connectée au RÉSEAU (via modem/routeur)
#   Renseignez l'adresse IP de l'imprimante sur le réseau local.
#   (Trouvez l'IP depuis le menu de l'imprimante ou votre box/routeur)
#
# PRINTER_IP=192.168.1.150
# PRINTER_PORT=631

# ▶ Cas 2 — Imprimante connectée en USB (Linux uniquement)
#   Renseignez le nom de la file CUPS de l'imprimante.
#   (Trouvez le nom avec la commande : lpstat -a)
#
# PRINTER_NAME=Xprinter-80mm

# ─────────────────────────────────────────────
#  WINDOWS UNIQUEMENT
# ─────────────────────────────────────────────
# Nom exact de l'imprimante tel qu'il apparaît dans
# "Panneau de configuration > Périphériques et imprimantes"
# Laissez vide pour utiliser l'imprimante par défaut de Windows.
#
# PRINTER_NAME=Xprinter XP-80
